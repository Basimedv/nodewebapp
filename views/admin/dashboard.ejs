<link rel="stylesheet" href="/css/admindashboard.css" />
<%- include("../partials/admin/header") %>

<div class="sidebar d-none d-lg-block">
  <%- include("../partials/admin/sidebar_links") %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<main class="main-content">
  <div class="container-fluid">
    <div
      class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4"
    >
      <div>
        <h2 class="dashboard-title mb-0">Dashboard</h2>
        <p class="text-muted mb-0" style="font-size: 13px">
          Welcome back, Admin
        </p>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <label
          for="periodFilter"
          class="text-muted mb-0"
          style="font-size: 13px"
          >Period</label
        >
        <select
          id="periodFilter"
          class="form-select w-auto"
          onchange="onPeriodChange(this.value)"
        >
          <option value="daily">Today</option>
          <option value="weekly">This week</option>
          <option value="monthly" selected>This month</option>
          <option value="yearly">This year</option>
          <option value="custom">Custom range</option>
        </select>
      </div>
    </div>

    <!-- Custom range bar -->
    <div
      id="customRangeBar"
      class="d-none d-flex align-items-center gap-2 flex-wrap mb-4"
      style="
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
      "
    >
      <span class="text-muted" style="font-size: 13px">From</span>
      <input
        type="date"
        id="startDate"
        class="form-control form-control-sm w-auto"
      />
      <span class="text-muted" style="font-size: 13px">To</span>
      <input
        type="date"
        id="endDate"
        class="form-control form-control-sm w-auto"
      />
      <button
        class="btn btn-sm btn-outline-primary"
        onclick="applyCustomRange()"
      >
        Apply
      </button>
      <span
        id="rangeError"
        class="text-danger d-none"
        style="font-size: 12px"
      ></span>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
          <div class="icon-container bg-primary">
            <i class="bi bi-people-fill"></i>
          </div>
          <div class="card-body">
            <p>Total Customers</p>
            <h5 id="totalCustomers">...</h5>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
          <div class="icon-container bg-success">
            <i class="bi bi-currency-rupee"></i>
          </div>
          <div class="card-body">
            <p>Total Revenue</p>
            <h5 id="totalSales">...</h5>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
          <div class="icon-container bg-warning">
            <i class="bi bi-bag-check-fill"></i>
          </div>
          <div class="card-body">
            <p>Total Orders</p>
            <h5 id="totalOrders">...</h5>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
          <div class="icon-container bg-danger">
            <i class="bi bi-box-seam-fill"></i>
          </div>
          <div class="card-body">
            <p>Products Sold</p>
            <h5 id="productsSold">...</h5>
          </div>
        </div>
      </div>
    </div>

    <!-- Sales & Orders charts -->
    <div class="row g-3 mb-4">
      <div class="col-lg-7">
        <div class="chart-container">
          <h5>Revenue overview</h5>
          <canvas id="salesChart"></canvas>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="chart-container">
          <h5>Orders overview</h5>
          <canvas id="ordersChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Top 10 charts -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="chart-container">
          <h5>Top 5products</h5>
          <canvas id="productsChart"></canvas>
        </div>
      </div>
      <div class="col-md-4">
        <div class="chart-container">
          <h5>Top 5 categories</h5>
          <canvas id="categoriesChart"></canvas>
        </div>
      </div>
      <div class="col-md-4">
        <div class="chart-container">
          <h5>Top 5locations</h5>
          <canvas id="brandsChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  let salesChart, ordersChart, productsChart, categoriesChart, brandsChart;
  let currentPeriod = "monthly";

  const initialData = {
    users: parseInt("<%= locals.users         || 0 %>"),
    totalSales: parseFloat("<%= locals.totalSales  || 0 %>"),
    totalOrders: parseInt("<%= locals.totalOrders   || 0 %>"),
    totalProducts: parseInt("<%= locals.totalProducts || 0 %>"),
  };

  document.addEventListener("DOMContentLoaded", function () {
    setStatCards(
      initialData.users,
      initialData.totalSales,
      initialData.totalOrders,
      initialData.totalProducts,
    );
    initCharts();
    runUpdate();
    loadBestSellingData();
  });

  function setStatCards(customers, sales, orders, products) {
    document.getElementById("totalCustomers").textContent =
      Number(customers).toLocaleString("en-IN");
    document.getElementById("totalSales").textContent =
      "₹" + Number(sales).toLocaleString("en-IN");
    document.getElementById("totalOrders").textContent =
      Number(orders).toLocaleString("en-IN");
    document.getElementById("productsSold").textContent =
      Number(products).toLocaleString("en-IN");
  }

  function setLoadingCards() {
    ["totalCustomers", "totalSales", "totalOrders", "productsSold"].forEach(
      (id) => (document.getElementById(id).textContent = "—"),
    );
  }

  function onPeriodChange(val) {
    const bar = document.getElementById("customRangeBar");
    const err = document.getElementById("rangeError");
    if (val === "custom") {
      bar.classList.remove("d-none");
      document.getElementById("endDate").value = new Date()
        .toISOString()
        .split("T")[0];
    } else {
      bar.classList.add("d-none");
      err.classList.add("d-none");
      currentPeriod = val;
      runUpdate();
    }
  }

  function applyCustomRange() {
    const start = document.getElementById("startDate").value;
    const end = document.getElementById("endDate").value;
    const err = document.getElementById("rangeError");
    if (!start || !end) {
      err.textContent = "Please select both dates.";
      err.classList.remove("d-none");
      return;
    }
    if (new Date(start) > new Date(end)) {
      err.textContent = "End must be after start.";
      err.classList.remove("d-none");
      return;
    }
    err.classList.add("d-none");
    currentPeriod = "custom";
    runUpdate(start, end);
  }

  async function runUpdate(startDate = null, endDate = null) {
    setLoadingCards();
    let params = `period=${currentPeriod}`;
    if (currentPeriod === "custom" && startDate && endDate)
      params += `&start=${startDate}&end=${endDate}`;
    try {
      const [statsRes, chartRes] = await Promise.all([
        fetch(`/admin/dashboard/data?type=stats&${params}`),
        fetch(`/admin/dashboard/data?type=chart&${params}`),
      ]);
      if (statsRes.ok) {
        const { success, data } = await statsRes.json();
        if (success)
          setStatCards(
            data.totalCustomers,
            data.totalSales,
            data.totalOrders,
            data.productsSold,
          );
        else
          setStatCards(
            initialData.users,
            initialData.totalSales,
            initialData.totalOrders,
            initialData.totalProducts,
          );
      }
      if (chartRes.ok) {
        const { success, data } = await chartRes.json();
        if (success) updateLineBarCharts(data);
      }
    } catch (err) {
      console.error("runUpdate error:", err);
      setStatCards(
        initialData.users,
        initialData.totalSales,
        initialData.totalOrders,
        initialData.totalProducts,
      );
    }
  }

  const chartDefaults = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { display: false }, ticks: { font: { size: 11 } } },
      y: {
        beginAtZero: true,
        grid: { color: "#f0f4f8" },
        ticks: { font: { size: 11 } },
      },
    },
  };

  function initCharts() {
    salesChart = new Chart(document.getElementById("salesChart"), {
      type: "line",
      data: {
        labels: [],
        datasets: [
          {
            label: "Revenue (₹)",
            data: [],
            borderColor: "#3b6da1",
            backgroundColor: "rgba(59,109,161,0.07)",
            borderWidth: 2.5,
            fill: true,
            tension: 0.45,
            pointRadius: 3,
            pointBackgroundColor: "#3b6da1",
          },
        ],
      },
      options: {
        ...chartDefaults,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 11 } } },
          y: {
            beginAtZero: true,
            grid: { color: "#f0f4f8" },
            ticks: {
              font: { size: 11 },
              callback: (v) => "₹" + Number(v).toLocaleString("en-IN"),
            },
          },
        },
      },
    });

    ordersChart = new Chart(document.getElementById("ordersChart"), {
      type: "bar",
      data: {
        labels: [],
        datasets: [
          {
            label: "Orders",
            data: [],
            backgroundColor: "rgba(22,163,74,0.15)",
            borderColor: "#16a34a",
            borderWidth: 1.5,
            borderRadius: 6,
          },
        ],
      },
      options: { ...chartDefaults },
    });

    productsChart = new Chart(document.getElementById("productsChart"), {
      type: "bar",
      data: {
        labels: [],
        datasets: [
          {
            label: "Units sold",
            data: [],
            backgroundColor: "rgba(59,109,161,0.15)",
            borderColor: "#3b6da1",
            borderWidth: 1.5,
            borderRadius: 4,
          },
        ],
      },
      options: {
        ...chartDefaults,
        indexAxis: "y",
        scales: {
          x: {
            beginAtZero: true,
            grid: { color: "#f0f4f8" },
            ticks: { font: { size: 10 } },
          },
          y: { grid: { display: false }, ticks: { font: { size: 10 } } },
        },
      },
    });

    categoriesChart = new Chart(document.getElementById("categoriesChart"), {
      type: "bar",
      data: {
        labels: [],
        datasets: [
          {
            label: "Units sold",
            data: [],
            backgroundColor: "rgba(217,119,6,0.15)",
            borderColor: "#d97706",
            borderWidth: 1.5,
            borderRadius: 4,
          },
        ],
      },
      options: {
        ...chartDefaults,
        indexAxis: "y",
        scales: {
          x: {
            beginAtZero: true,
            grid: { color: "#f0f4f8" },
            ticks: { font: { size: 10 } },
          },
          y: { grid: { display: false }, ticks: { font: { size: 10 } } },
        },
      },
    });

    brandsChart = new Chart(document.getElementById("brandsChart"), {
      type: "bar",
      data: {
        labels: [],
        datasets: [
          {
            label: "Units sold",
            data: [],
            backgroundColor: "rgba(220,38,38,0.12)",
            borderColor: "#dc2626",
            borderWidth: 1.5,
            borderRadius: 4,
          },
        ],
      },
      options: {
        ...chartDefaults,
        indexAxis: "y",
        scales: {
          x: {
            beginAtZero: true,
            grid: { color: "#f0f4f8" },
            ticks: { font: { size: 10 } },
          },
          y: { grid: { display: false }, ticks: { font: { size: 10 } } },
        },
      },
    });
  }

  function updateLineBarCharts(data) {
    if (!data) return;
    if (salesChart && data.labels) {
      salesChart.data.labels = data.labels;
      salesChart.data.datasets[0].data = data.sales || [];
      salesChart.update();
    }
    if (ordersChart && data.labels) {
      ordersChart.data.labels = data.labels;
      ordersChart.data.datasets[0].data = data.orders || [];
      ordersChart.update();
    }
  }

  async function loadBestSellingData() {
    try {
      const [pRes, cRes, bRes] = await Promise.all([
        fetch("/admin/dashboard/data?type=products"),
        fetch("/admin/dashboard/data?type=categories"),
        fetch("/admin/dashboard/data?type=brands"),
      ]);
      if (pRes.ok) {
        const { success, data } = await pRes.json();
        if (success && data.length) {
          productsChart.data.labels = data.map((d) =>
            (d.name || "Unknown").substring(0, 18),
          );
          productsChart.data.datasets[0].data = data.map(
            (d) => d.totalQuantity || 0,
          );
          productsChart.update();
        }
      }
      if (cRes.ok) {
        const { success, data } = await cRes.json();
        if (success && data.length) {
          categoriesChart.data.labels = data.map((d) => d.name || "Unknown");
          categoriesChart.data.datasets[0].data = data.map(
            (d) => d.totalQuantity || 0,
          );
          categoriesChart.update();
        }
      }
      if (bRes.ok) {
        const { success, data } = await bRes.json();
        if (success && data.length) {
          brandsChart.data.labels = data.map((d) => d.name || "Unknown");
          brandsChart.data.datasets[0].data = data.map(
            (d) => d.totalQuantity || 0,
          );
          brandsChart.update();
        }
      }
    } catch (err) {
      console.error("loadBestSellingData error:", err);
    }
  }

  (function lockBackNav() {
    for (let i = 0; i < 5; i++) history.pushState(null, "", location.href);
    window.addEventListener("popstate", () =>
      window.location.replace("/admin/dashboard"),
    );
  })();
</script>

<%- include("../partials/admin/footer") %>
