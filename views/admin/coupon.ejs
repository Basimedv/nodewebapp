<%- include("../partials/admin/header") %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .main-content {
        padding: 30px;
        background: #f5f7fa;
        min-height: 100vh;
        margin-left: 250px;
    }

    .table thead th {
        background: #3b6da1;
        color: white;
        font-weight: 500;
        border: none;
        padding: 14px 12px;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .search-btn { background-color: #3e29a8; color: white; }
    .search-btn:hover { background-color: #2e1e82; color: white; }

    .btn-add-coupon {
        background-color: #3b6da1;
        color: white;
        border: none;
        padding: 9px 22px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-add-coupon:hover { background-color: #2e5a8f; }

    .coupon-code {
        font-family: 'Courier New', monospace;
        font-weight: 700;
        background: #eef2ff;
        color: #3e29a8;
        padding: 3px 10px;
        border-radius: 5px;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    .type-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        white-space: nowrap;
    }
    .type-PERCENTAGE { background: #e0f2fe; color: #0284c7; }
    .type-FIXED      { background: #dcfce7; color: #16a34a; }

    .status-active   { background-color: #8af5bf; color: #0CAF60; border: 1px solid #0CAF60; font-weight: 500; }
    .status-inactive { background-color: #f9d3d3; color: #FD6A6A; border: 1px solid #FD6A6A; font-weight: 500; }
    .status-expired  { background-color: #fff3cd; color: #856404; border: 1px solid #ffc107; font-weight: 500; }
    .status-upcoming { background-color: #e0f2fe; color: #0284c7; border: 1px solid #7dd3fc; font-weight: 500; }

    .btn-delete {
        background: none; border: none; cursor: pointer;
        padding: 6px 10px; border-radius: 6px; transition: background 0.2s;
    }
    .btn-delete:hover { background: #fde8e8; }
    .btn-delete i { color: #FD6A6A; font-size: 1.1rem; }

    .btn-edit {
        background: none; border: none; cursor: pointer;
        padding: 6px 10px; border-radius: 6px; transition: background 0.2s;
    }
    .btn-edit:hover { background: #e8f0fb; }
    .btn-edit i { color: #3b6da1; font-size: 1.1rem; }

    .btn-toggle {
        transition: transform 0.2s; cursor: pointer;
        background: none; border: none; padding: 0;
    }
    .btn-toggle:hover { transform: scale(1.1); }

    .usage-bar-wrap { display: flex; align-items: center; gap: 6px; min-width: 80px; }
    .usage-bar { flex: 1; height: 5px; background: #e5e7eb; border-radius: 3px; overflow: hidden; }
    .usage-bar-fill { height: 100%; background: #3b6da1; border-radius: 3px; }
    .usage-text { font-size: 0.72rem; color: #888; white-space: nowrap; }

    .empty-state { text-align: center; padding: 60px 20px; color: #aaa; }
    .empty-state i { font-size: 3rem; margin-bottom: 14px; display: block; color: #ddd; }

    /* ── Modal shared styles ── */
    .modal-header { background: #3b6da1; color: white; border-radius: 12px 12px 0 0; }
    .modal-header .btn-close { filter: invert(1); }
    .modal-content { border-radius: 12px; border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.15); }

    .modal-form-label { font-weight: 600; font-size: 0.875rem; color: #333; margin-bottom: 5px; display: block; }

    .modal-form-control {
        border: 1.5px solid #e0e0e0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.875rem;
        width: 100%;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #fff;
    }
    .modal-form-control:focus {
        border-color: #3b6da1;
        box-shadow: 0 0 0 3px rgba(59,109,161,0.12);
        outline: none;
    }
    .modal-form-control.is-invalid { border-color: #FD6A6A; }
    .modal-invalid-feedback { font-size: 0.78rem; color: #FD6A6A; display: none; margin-top: 3px; }
    .modal-form-control.is-invalid ~ .modal-invalid-feedback { display: block; }

    .hint { font-size: 0.78rem; color: #999; margin-top: 3px; }

    .coupon-preview-box {
        background: linear-gradient(135deg, #f8f9ff 0%, #eef2ff 100%);
        border: 1.5px dashed #c5d0f0;
        border-radius: 10px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }
    .preview-code {
        font-family: 'Courier New', monospace;
        font-weight: 800;
        background: #3e29a8;
        color: #fff;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 1rem;
        letter-spacing: 2px;
        min-width: 80px;
        text-align: center;
    }
    .preview-details { font-size: 0.82rem; color: #555; line-height: 1.6; }

    .input-prefix {
        background: #f5f5f5;
        border: 1.5px solid #e0e0e0;
        border-right: none;
        border-radius: 8px 0 0 8px;
        padding: 10px 12px;
        font-size: 0.875rem;
        color: #555;
        white-space: nowrap;
    }
    .input-with-prefix { border-radius: 0 8px 8px 0 !important; border-left: none !important; }

    .btn-modal-save {
        background-color: #3b6da1;
        color: white; border: none;
        padding: 10px 28px; border-radius: 8px;
        font-weight: 600; font-size: 0.9rem;
        transition: background 0.2s;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-modal-save:hover { background-color: #2e5a8f; color: white; }

    .section-divider {
        font-size: 0.72rem;
        font-weight: 700;
        color: #3b6da1;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border-bottom: 1.5px solid #e8edf5;
        padding-bottom: 6px;
        margin: 20px 0 14px;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        border-radius: 8px;
        background: #f8f9ff;
        border: 1.5px solid #e4e8f5;
        margin-bottom: 8px;
    }
    .toggle-row-label { font-size: 0.875rem; font-weight: 600; color: #333; }
    .toggle-row-sub   { font-size: 0.75rem; color: #888; margin-top: 1px; }
</style>

<aside class="sidebar d-none d-lg-block">
    <%- include("../partials/admin/sidebar_links") %>
</aside>

<main class="main-content">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold m-0" style="font-family: 'Outfit', sans-serif;">Coupon Management</h2>
                <p class="text-muted small mt-1 mb-0">Create and manage discount coupons</p>
            </div>
            <button class="btn-add-coupon" data-bs-toggle="modal" data-bs-target="#addCouponModal">
                <i class="bi bi-plus-lg"></i> Add Coupon
            </button>
        </div>

        <!-- Filter + Search -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <label class="small text-muted mb-1">Filter Status</label>
                        <select class="form-select shadow-none" id="filterStatus">
                            <option value="all">All Coupons</option>
                            <option value="active">Active</option>
                            <option value="upcoming">Upcoming</option>
                            <option value="expired">Expired</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-6 ms-auto">
                        <label class="small text-muted mb-1">Search Coupon</label>
                        <form id="searchForm" class="input-group">
                            <input type="text" class="form-control shadow-none" id="searchval"
                                placeholder="Search coupon code..." value="<%= searchQuery || '' %>">
                            <button class="btn search-btn px-4" type="submit">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                            <a href="/admin/coupons" class="btn btn-outline-secondary">Reset</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="couponTable">
                    <thead>
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Discount</th>
                            <th>Max Cap</th>
                            <th>Min Order</th>
                            <th>Usage</th>
                            <th>Valid From</th>
                            <th>Valid Until</th>
                            <th>Restrictions</th>
                            <th>Status</th>
                            <th class="text-center">Active</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                      <% if (coupons && coupons.length > 0) { %>
    <% coupons.forEach((coupon, index) => {
        const now = new Date();
        const dCode    = coupon.code        || coupon.name        || '—';
        const dType    = coupon.type        || 'FIXED';
        const dValue   = coupon.value       != null ? coupon.value : (coupon.offerPrice || 0);
        const dMax     = coupon.maxDiscount || 0;
        const dMin     = coupon.minOrderAmount != null ? coupon.minOrderAmount : (coupon.minimumPrice || 0);
        const dLimit   = coupon.usageLimit  || 0;
        const dUsed    = coupon.usedCount   || 0;
        const dActive  = coupon.isActive    != null ? coupon.isActive : true;
        const dStart   = coupon.startDate   ? new Date(coupon.startDate) : new Date(coupon.createdOn || now);
        const dEnd     = coupon.endDate     ? new Date(coupon.endDate)   : new Date(coupon.expireOn  || now);
        const dDesc    = coupon.description || '';
        const dFirst   = coupon.firstOrderOnly || false;

        const isExpired  = dEnd   < now;
        const isUpcoming = dStart > now;

        let statusLabel, statusClass;
        if (!dActive)        { statusLabel = 'Inactive'; statusClass = 'status-inactive'; }
        else if (isExpired)  { statusLabel = 'Expired';  statusClass = 'status-expired';  }
        else if (isUpcoming) { statusLabel = 'Upcoming'; statusClass = 'status-upcoming'; }
        else                 { statusLabel = 'Active';   statusClass = 'status-active';   }

        const usagePct = dLimit > 0 ? Math.min(Math.round((dUsed / dLimit) * 100), 100) : 0;

        // Format dates for input[type=date] (YYYY-MM-DD)
        const startISO = dStart.toISOString().split('T')[0];
        const endISO   = dEnd.toISOString().split('T')[0];
    %>
        <tr data-status="<%= statusLabel.toLowerCase() %>">
            <td class="ps-4 text-muted small"><%= index + 1 %></td>
            <td><span class="coupon-code"><%= dCode %></span></td>
            <td><span class="type-badge type-<%= dType %>"><%= dType %></span></td>
            <td class="fw-bold text-success">
                <% if (dType === 'PERCENTAGE') { %><%= dValue %>%<% } else { %>₹<%= dValue.toLocaleString('en-IN') %><% } %>
            </td>
            <td class="text-muted small">
                <% if (dType === 'PERCENTAGE' && dMax > 0) { %>₹<%= dMax.toLocaleString('en-IN') %><% } else { %>—<% } %>
            </td>
            <td class="text-muted small">
                <% if (dMin > 0) { %>₹<%= dMin.toLocaleString('en-IN') %><% } else { %>—<% } %>
            </td>
            <td>
                <% if (dLimit > 0) { %>
                    <div class="usage-bar-wrap">
                        <div class="usage-bar"><div class="usage-bar-fill" data-width="<%= usagePct %>"></div></div>
                        <span class="usage-text"><%= dUsed %>/<%= dLimit %></span>
                    </div>
                <% } else { %>
                    <span class="text-muted small">Unlimited</span>
                <% } %>
            </td>
            <td class="text-muted small">
                <%= dStart.toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
            </td>
            <td class="text-muted small">
                <%= dEnd.toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
            </td>
            <td class="small">
                <% const flags = []; %>
                <% if (dFirst) flags.push('1st order'); %>
                <% if (coupon.allowedUsers && coupon.allowedUsers.length > 0) flags.push('Specific users'); %>
                <% if (coupon.applicableCategories && coupon.applicableCategories.length > 0) flags.push('Categories'); %>
                <% if (flags.length > 0) { %>
                    <span class="text-primary"><%= flags.join(', ') %></span>
                <% } else { %>
                    <span class="text-muted">All users</span>
                <% } %>
            </td>
            <td>
                <span class="badge rounded-pill <%= statusClass %> px-3 py-2"><%= statusLabel %></span>
            </td>
            <td class="text-center">
                <button class="btn-toggle" data-id="<%= coupon._id %>" onclick="toggleCoupon(this)" type="button">
                    <i class="bi <%= dActive ? 'bi-toggle-on text-success' : 'bi-toggle-off text-danger' %> fs-2"></i>
                </button>
            </td>
            <td class="text-end pe-4">
                <!-- Edit button — passes all coupon data as data-* attributes -->
                <button class="btn-edit"
                    onclick="openEditModal(this)"
                    data-id="<%= coupon._id %>"
                    data-code="<%= dCode %>"
                    data-type="<%= dType %>"
                    data-value="<%= dValue %>"
                    data-maxdiscount="<%= dMax %>"
                    data-minorderamount="<%= dMin %>"
                    data-usagelimit="<%= dLimit %>"
                    data-startdate="<%= startISO %>"
                    data-enddate="<%= endISO %>"
                    data-description="<%= dDesc %>"
                    data-firstorderonly="<%= dFirst %>"
                    data-isactive="<%= dActive %>">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn-delete"
                    data-id="<%= coupon._id %>"
                    data-name="<%= dCode %>"
                    onclick="deleteCoupon(this)">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>
    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="13">
                                    <div class="empty-state">
                                        <i class="bi bi-ticket-perforated"></i>
                                        <p class="fw-semibold mb-1">No coupons found</p>
                                        <p class="small">Click "Add Coupon" to create your first coupon.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages >= 1) { %>
                <div class="d-flex justify-content-center py-3">
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>&query=<%= searchQuery || '' %>">←</a>
                            </li>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                        <a class="page-link" href="?page=<%= i %>&query=<%= searchQuery || '' %>"><%= i %></a>
                                    </li>
                                <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                <% } %>
                            <% } %>
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&query=<%= searchQuery || '' %>">→</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            <% } %>
        </div>
    </div>
</main>

<!-- ══════════════════════════════════════════════════════════
     ADD COUPON MODAL
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="addCouponModal" tabindex="-1" aria-labelledby="addCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:600px;">
        <div class="modal-content">
            <div class="modal-header px-4 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-ticket-perforated me-2"></i> Add New Coupon
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <div class="coupon-preview-box">
                    <span class="preview-code" id="previewCode">CODE</span>
                    <div class="preview-details" id="previewDetails">Fill the form to see a preview</div>
                </div>
                <form id="addCouponForm" novalidate>
                    <div class="section-divider">Basic Info</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Code <span class="text-danger">*</span></label>
                            <input type="text" id="m_code" class="modal-form-control"
                                placeholder="e.g. SAVE20" maxlength="20"
                                style="text-transform:uppercase; letter-spacing:1px; font-family:'Courier New',monospace; font-weight:700;">
                            <div class="modal-invalid-feedback" id="err_code">Code is required.</div>
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">Type <span class="text-danger">*</span></label>
                            <select id="m_type" class="modal-form-control" onchange="onTypeChange('add')">
                                <option value="PERCENTAGE">Percentage (%)</option>
                                <option value="FIXED">Fixed Amount (₹)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label" id="lbl_value">Discount % <span class="text-danger">*</span></label>
                            <div class="d-flex">
                                <span class="input-prefix" id="prefix_value">%</span>
                                <input type="number" id="m_value" class="modal-form-control input-with-prefix" placeholder="20" min="1">
                            </div>
                            <div class="modal-invalid-feedback" id="err_value">Enter a valid value.</div>
                        </div>
                        <div class="col-6" id="maxDiscountCol">
                            <label class="modal-form-label">Max Discount (₹)</label>
                            <div class="d-flex">
                                <span class="input-prefix">₹</span>
                                <input type="number" id="m_maxDiscount" class="modal-form-control input-with-prefix" placeholder="500" min="0">
                            </div>
                            <div class="hint">Cap on percentage savings</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="modal-form-label">Description</label>
                        <input type="text" id="m_description" class="modal-form-control" placeholder="e.g. Summer sale — 20% off all orders">
                    </div>
                    <div class="section-divider">Order Constraints</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Min Order Amount (₹)</label>
                            <div class="d-flex">
                                <span class="input-prefix">₹</span>
                                <input type="number" id="m_minOrderAmount" class="modal-form-control input-with-prefix" placeholder="1000" min="0">
                            </div>
                            <div class="hint">Leave 0 for no minimum</div>
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">Usage Limit</label>
                            <input type="number" id="m_usageLimit" class="modal-form-control" placeholder="0 = unlimited" min="0">
                            <div class="hint">Total times this coupon can be used</div>
                        </div>
                    </div>
                    <div class="section-divider">Validity Period</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Start Date <span class="text-danger">*</span></label>
                            <input type="date" id="m_startDate" class="modal-form-control">
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">End Date <span class="text-danger">*</span></label>
                            <input type="date" id="m_endDate" class="modal-form-control">
                            <div class="modal-invalid-feedback" id="err_endDate">Select a valid end date.</div>
                        </div>
                    </div>
                    <div class="section-divider">Restrictions</div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-row-label">First Order Only</div>
                            <div class="toggle-row-sub">Only valid for a user's first purchase</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="m_firstOrderOnly" style="width:2.2rem; height:1.2rem; cursor:pointer;">
                        </div>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-row-label">Activate Immediately</div>
                            <div class="toggle-row-sub">Make coupon available to customers right away</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="m_isActive" checked style="width:2.2rem; height:1.2rem; cursor:pointer;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer px-4 pb-4 border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-modal-save" onclick="submitCoupon()">
                    <i class="bi bi-check-lg"></i> Create Coupon
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     EDIT COUPON MODAL
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="editCouponModal" tabindex="-1" aria-labelledby="editCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:600px;">
        <div class="modal-content">
            <div class="modal-header px-4 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square me-2"></i> Edit Coupon
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-4">

                <!-- Live Preview -->
                <div class="coupon-preview-box">
                    <span class="preview-code" id="e_previewCode">CODE</span>
                    <div class="preview-details" id="e_previewDetails">Loading...</div>
                </div>

                <form id="editCouponForm" novalidate>
                    <input type="hidden" id="e_id">

                    <div class="section-divider">Basic Info</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Code <span class="text-danger">*</span></label>
                            <input type="text" id="e_code" class="modal-form-control"
                                placeholder="e.g. SAVE20" maxlength="20"
                                style="text-transform:uppercase; letter-spacing:1px; font-family:'Courier New',monospace; font-weight:700;">
                            <div class="modal-invalid-feedback" id="e_err_code">Code is required.</div>
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">Type <span class="text-danger">*</span></label>
                            <select id="e_type" class="modal-form-control" onchange="onTypeChange('edit')">
                                <option value="PERCENTAGE">Percentage (%)</option>
                                <option value="FIXED">Fixed Amount (₹)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label" id="e_lbl_value">Discount % <span class="text-danger">*</span></label>
                            <div class="d-flex">
                                <span class="input-prefix" id="e_prefix_value">%</span>
                                <input type="number" id="e_value" class="modal-form-control input-with-prefix" placeholder="20" min="1">
                            </div>
                            <div class="modal-invalid-feedback" id="e_err_value">Enter a valid value.</div>
                        </div>
                        <div class="col-6" id="e_maxDiscountCol">
                            <label class="modal-form-label">Max Discount (₹)</label>
                            <div class="d-flex">
                                <span class="input-prefix">₹</span>
                                <input type="number" id="e_maxDiscount" class="modal-form-control input-with-prefix" placeholder="500" min="0">
                            </div>
                            <div class="hint">Cap on percentage savings</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="modal-form-label">Description</label>
                        <input type="text" id="e_description" class="modal-form-control" placeholder="e.g. Summer sale — 20% off">
                    </div>

                    <div class="section-divider">Order Constraints</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Min Order Amount (₹)</label>
                            <div class="d-flex">
                                <span class="input-prefix">₹</span>
                                <input type="number" id="e_minOrderAmount" class="modal-form-control input-with-prefix" placeholder="1000" min="0">
                            </div>
                            <div class="hint">Leave 0 for no minimum</div>
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">Usage Limit</label>
                            <input type="number" id="e_usageLimit" class="modal-form-control" placeholder="0 = unlimited" min="0">
                            <div class="hint">Total times this coupon can be used</div>
                        </div>
                    </div>

                    <div class="section-divider">Validity Period</div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="modal-form-label">Start Date <span class="text-danger">*</span></label>
                            <input type="date" id="e_startDate" class="modal-form-control">
                        </div>
                        <div class="col-6">
                            <label class="modal-form-label">End Date <span class="text-danger">*</span></label>
                            <input type="date" id="e_endDate" class="modal-form-control">
                            <div class="modal-invalid-feedback" id="e_err_endDate">Select a valid end date.</div>
                        </div>
                    </div>

                    <div class="section-divider">Restrictions</div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-row-label">First Order Only</div>
                            <div class="toggle-row-sub">Only valid for a user's first purchase</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="e_firstOrderOnly" style="width:2.2rem; height:1.2rem; cursor:pointer;">
                        </div>
                    </div>
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-row-label">Active</div>
                            <div class="toggle-row-sub">Make coupon available to customers</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="e_isActive" style="width:2.2rem; height:1.2rem; cursor:pointer;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer px-4 pb-4 border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-modal-save" onclick="submitEditCoupon()">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/admin/footer") %>

<script>
    const todayStr = new Date().toISOString().split('T')[0];
    document.getElementById('m_startDate').value = todayStr;
    document.getElementById('m_startDate').min   = todayStr;
    document.getElementById('m_endDate').min     = todayStr;

    // ── Type change (works for both add and edit modals) ──────────
    function onTypeChange(mode) {
        const prefix = mode === 'edit' ? 'e_' : '';
        const typeEl = document.getElementById(prefix + 'type');
        if (!typeEl) return; // guard: modal not in DOM yet
        const isPerc = typeEl.value === 'PERCENTAGE';
        const lblEl  = document.getElementById(prefix + 'lbl_value');
        const preEl  = document.getElementById(prefix + 'prefix_value');
        const capEl  = document.getElementById(prefix + 'maxDiscountCol');
        const maxEl  = document.getElementById(prefix + 'maxDiscount');
        if (lblEl) lblEl.innerHTML = (isPerc ? 'Discount %' : 'Discount (₹)') + ' <span class="text-danger">*</span>';
        if (preEl) preEl.textContent = isPerc ? '%' : '₹';
        if (capEl) capEl.style.opacity = isPerc ? '1' : '0.4';
        if (maxEl) { maxEl.disabled = !isPerc; if (!isPerc) maxEl.value = ''; }
        updatePreview(mode);
    }

    // ── Live Preview ──────────────────────────────────────────────
    function updatePreview(mode) {
        const p = mode === 'edit' ? 'e_' : '';
        const code   = document.getElementById(p + 'code')?.value.trim().toUpperCase() || 'CODE';
        const type   = document.getElementById(p + 'type')?.value;
        const val    = document.getElementById(p + 'value')?.value;
        const maxD   = document.getElementById(p + 'maxDiscount')?.value;
        const minAmt = document.getElementById(p + 'minOrderAmount')?.value;
        const limit  = document.getElementById(p + 'usageLimit')?.value;
        const start  = document.getElementById(p + 'startDate')?.value;
        const end    = document.getElementById(p + 'endDate')?.value;
        const first  = document.getElementById(p + 'firstOrderOnly')?.checked;

        const codeEl    = document.getElementById(p + 'previewCode');
        const detailEl  = document.getElementById(p + 'previewDetails');
        if (!codeEl || !detailEl) return;

        codeEl.textContent = code;

        let lines = [];
        if (val) lines.push(type === 'PERCENTAGE'
            ? `${val}% off${maxD ? ` (max ₹${Number(maxD).toLocaleString('en-IN')})` : ''}`
            : `₹${Number(val).toLocaleString('en-IN')} off`);
        if (minAmt && Number(minAmt) > 0) lines.push(`Min order: ₹${Number(minAmt).toLocaleString('en-IN')}`);
        if (limit  && Number(limit)  > 0) lines.push(`Limit: ${limit} uses`);
        if (start && end) lines.push(`Valid: ${new Date(start).toLocaleDateString('en-IN',{day:'2-digit',month:'short'})} – ${new Date(end).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})}`);
        if (first) lines.push('First order only');

        detailEl.innerHTML = lines.length
            ? lines.map(l => `<span>${l}</span>`).join(' &nbsp;·&nbsp; ')
            : 'Fill the form to see a preview';
    }

    // Wire up add modal live preview
    ['m_code','m_value','m_maxDiscount','m_minOrderAmount','m_usageLimit','m_startDate','m_endDate'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', () => updatePreview('add'));
    });
    document.getElementById('m_firstOrderOnly').addEventListener('change', () => updatePreview('add'));

    // Wire up edit modal live preview
    ['e_code','e_value','e_maxDiscount','e_minOrderAmount','e_usageLimit','e_startDate','e_endDate'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', () => updatePreview('edit'));
    });
    document.getElementById('e_firstOrderOnly').addEventListener('change', () => updatePreview('edit'));

    // Auto-uppercase code (add modal)
    document.getElementById('m_code').addEventListener('input', function () {
        const pos  = this.selectionStart;
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
        this.setSelectionRange(pos, pos);
        updatePreview('add');
    });

    // Auto-uppercase code (edit modal)
    document.getElementById('e_code').addEventListener('input', function () {
        const pos  = this.selectionStart;
        this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
        this.setSelectionRange(pos, pos);
        updatePreview('edit');
    });

    // ── Reset add modal on close ──────────────────────────────────
    document.getElementById('addCouponModal').addEventListener('hidden.bs.modal', () => {
        document.getElementById('addCouponForm').reset();
        document.getElementById('m_startDate').value = todayStr;
        document.getElementById('m_isActive').checked = true;
        document.getElementById('previewCode').textContent = 'CODE';
        document.getElementById('previewDetails').textContent = 'Fill the form to see a preview';
        document.querySelectorAll('#addCouponModal .modal-form-control').forEach(el => el.classList.remove('is-invalid'));
        onTypeChange('add');
    });

    // ── Open Edit Modal — populate all fields from data-* attrs ──
    function openEditModal(btn) {
        const d = btn.dataset;

        document.getElementById('e_id').value             = d.id;
        document.getElementById('e_code').value           = d.code;
        document.getElementById('e_type').value           = d.type;
        document.getElementById('e_value').value          = d.value;
        document.getElementById('e_maxDiscount').value    = d.maxdiscount   || 0;
        document.getElementById('e_minOrderAmount').value = d.minorderamount || 0;
        document.getElementById('e_usageLimit').value     = d.usagelimit    || 0;
        document.getElementById('e_startDate').value      = d.startdate;
        document.getElementById('e_endDate').value        = d.enddate;
        document.getElementById('e_description').value    = d.description   || '';
        document.getElementById('e_firstOrderOnly').checked = d.firstorderonly === 'true';
        document.getElementById('e_isActive').checked      = d.isactive === 'true';

        // Clear any previous validation errors
        document.querySelectorAll('#editCouponModal .modal-form-control').forEach(el => el.classList.remove('is-invalid'));

        // Sync type-dependent UI then refresh preview
        onTypeChange('edit');

        bootstrap.Modal.getOrCreateInstance(document.getElementById('editCouponModal')).show();
    }

    // ── Submit Edit ───────────────────────────────────────────────
    async function submitEditCoupon() {
        const id             = document.getElementById('e_id').value;
        const code           = document.getElementById('e_code').value.trim();
        const type           = document.getElementById('e_type').value;
        const value          = Number(document.getElementById('e_value').value);
        const maxDiscount    = Number(document.getElementById('e_maxDiscount').value)    || 0;
        const minOrderAmount = Number(document.getElementById('e_minOrderAmount').value) || 0;
        const usageLimit     = Number(document.getElementById('e_usageLimit').value)     || 0;
        const startDate      = document.getElementById('e_startDate').value;
        const endDate        = document.getElementById('e_endDate').value;
        const description    = document.getElementById('e_description').value.trim();
        const firstOrderOnly = document.getElementById('e_firstOrderOnly').checked;
        const isActive       = document.getElementById('e_isActive').checked;

        let valid = true;
        ['e_code','e_value','e_endDate'].forEach(id =>
            document.getElementById(id).classList.remove('is-invalid'));

        if (!code)               { document.getElementById('e_code').classList.add('is-invalid');    valid = false; }
        if (!value || value < 1) { document.getElementById('e_value').classList.add('is-invalid');   valid = false; }
        if (type === 'PERCENTAGE' && value > 100) {
            document.getElementById('e_value').classList.add('is-invalid');
            Swal.fire({ icon: 'warning', title: 'Invalid %', text: 'Percentage cannot exceed 100.' }); return;
        }
        if (!endDate)            { document.getElementById('e_endDate').classList.add('is-invalid'); valid = false; }
        if (endDate && startDate && new Date(endDate) <= new Date(startDate)) {
            document.getElementById('e_endDate').classList.add('is-invalid');
            Swal.fire({ icon: 'warning', title: 'Invalid Dates', text: 'End date must be after start date.' }); return;
        }
        if (!valid) return;

        try {
            const res = await fetch(`/admin/coupons/${id}/edit`, {
                method:  'PUT',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({
                    code, type, value, maxDiscount, minOrderAmount,
                    usageLimit, startDate, endDate, description,
                    firstOrderOnly, isActive
                })
            });
            const result = await res.json();

            if (res.ok && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editCouponModal')).hide();
                Swal.fire({
                    icon: 'success', title: 'Coupon Updated!',
                    text: `"${code}" saved successfully.`,
                    showConfirmButton: false, timer: 1200
                }).then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Failed to update coupon.' });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Please try again.' });
        }
    }

    // ── Submit Add ────────────────────────────────────────────────
    async function submitCoupon() {
        const code           = document.getElementById('m_code').value.trim();
        const type           = document.getElementById('m_type').value;
        const value          = Number(document.getElementById('m_value').value);
        const maxDiscount    = Number(document.getElementById('m_maxDiscount').value)    || 0;
        const minOrderAmount = Number(document.getElementById('m_minOrderAmount').value) || 0;
        const usageLimit     = Number(document.getElementById('m_usageLimit').value)     || 0;
        const startDate      = document.getElementById('m_startDate').value;
        const endDate        = document.getElementById('m_endDate').value;
        const description    = document.getElementById('m_description').value.trim();
        const firstOrderOnly = document.getElementById('m_firstOrderOnly').checked;
        const isActive       = document.getElementById('m_isActive').checked;
        let valid = true;

        ['m_code','m_value','m_endDate'].forEach(id =>
            document.getElementById(id).classList.remove('is-invalid'));

        if (!code)               { document.getElementById('m_code').classList.add('is-invalid');    valid = false; }
        if (!value || value < 1) { document.getElementById('m_value').classList.add('is-invalid');   valid = false; }
        if (type === 'PERCENTAGE' && value > 100) {
            document.getElementById('m_value').classList.add('is-invalid');
            Swal.fire({ icon: 'warning', title: 'Invalid %', text: 'Percentage cannot exceed 100.' }); return;
        }
        if (!endDate)            { document.getElementById('m_endDate').classList.add('is-invalid'); valid = false; }
        if (endDate && startDate && new Date(endDate) <= new Date(startDate)) {
            document.getElementById('m_endDate').classList.add('is-invalid');
            Swal.fire({ icon: 'warning', title: 'Invalid Dates', text: 'End date must be after start date.' }); return;
        }
        if (!valid) return;

        try {
            const res = await fetch('/admin/coupons/add', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ code, type, value, maxDiscount, minOrderAmount, usageLimit, startDate, endDate, description, firstOrderOnly, isActive })
            });
            const result = await res.json();
            if (res.ok && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('addCouponModal')).hide();
                Swal.fire({ icon: 'success', title: 'Coupon Created!', text: `"${code}" added successfully.`, showConfirmButton: false, timer: 1200 })
                    .then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Failed to create coupon.' });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Please try again.' });
        }
    }

    // ── Search ────────────────────────────────────────────────────
    document.getElementById('searchForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const q = document.getElementById('searchval').value.trim();
        window.location.href = `/admin/coupons?query=${encodeURIComponent(q)}&page=1`;
    });

    // ── Filter ────────────────────────────────────────────────────
    document.getElementById('filterStatus').addEventListener('change', function () {
        document.querySelectorAll('#couponTable tbody tr[data-status]').forEach(row => {
            row.style.display = (this.value === 'all' || row.dataset.status === this.value) ? '' : 'none';
        });
    });

    // ── Toggle ────────────────────────────────────────────────────
    async function toggleCoupon(btn) {
        const id     = btn.dataset.id;
        const icon   = btn.querySelector('i');
        const isActive = icon.classList.contains('bi-toggle-on');
        const confirm = await Swal.fire({
            title: 'Confirm',
            text:  `Are you sure you want to ${isActive ? 'deactivate' : 'activate'} this coupon?`,
            icon:  'warning',
            showCancelButton: true,
            confirmButtonColor: isActive ? '#dc3545' : '#28a745',
            confirmButtonText:  isActive ? 'Yes, deactivate' : 'Yes, activate'
        });
        if (!confirm.isConfirmed) return;
        try {
            const res    = await fetch(`/admin/coupons/${id}/toggle`, { method: 'PUT', headers: { 'Content-Type': 'application/json' } });
            const result = await res.json();
            if (res.ok && result.success) {
                Swal.fire({ icon: 'success', title: 'Updated!', showConfirmButton: false, timer: 900 }).then(() => location.reload());
            } else { throw new Error(result.message || 'Update failed'); }
        } catch (err) { Swal.fire({ icon: 'error', title: 'Error', text: err.message }); }
    }

    // ── Delete ────────────────────────────────────────────────────
    async function deleteCoupon(btn) {
        const id   = btn.dataset.id;
        const name = btn.dataset.name;
        const confirm = await Swal.fire({
            title: `Delete "${name}"?`, text: 'This action cannot be undone.',
            icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#dc3545', confirmButtonText: 'Yes, delete'
        });
        if (!confirm.isConfirmed) return;
        try {
            const res    = await fetch(`/admin/coupons/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (res.ok && result.success) {
                Swal.fire({ icon: 'success', title: 'Deleted!', showConfirmButton: false, timer: 900 }).then(() => location.reload());
            } else { throw new Error(result.message || 'Delete failed'); }
        } catch (err) { Swal.fire({ icon: 'error', title: 'Error', text: err.message }); }
    }

    // Init
    onTypeChange('add');
</script>
